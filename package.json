{
  "name": "house-project",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "typecheck": "tsc --noEmit && tsc -p server",
    "build": "npm run typecheck && vite build && node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "stop": "node scripts/stop.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "express": "5.1.0",
    "pdfkit": "0.20.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.169.0"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.18.0",
    "@types/pdfkit": "0.17.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.169.0",
    "@vitejs/plugin-react": "4.3.3",
    "dxf-parser": "1.1.2",
    "tsx": "4.20.6",
    "typescript": "5.6.3",
    "vite": "5.4.21",
    "vite-plugin-singlefile": "2.0.3",
    "vitest": "2.1.9"
  }
}
